# Waste Calendar Configuration
POSTCODE=5000AA
HUISNUMMER=1

# Telegram Bot Setup
# 1. Open Telegram, search for @BotFather
# 2. Send /newbot, follow the prompts, copy the token below
# 3. Create a group chat (or use 1-on-1) and add your bot
# 4. Send any message in the group
# 5. Visit: https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
# 6. Find "chat":{"id":-100XXXXXXXXX} — that negative number is your CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

#Cron Schedule
CRON_SCHEDULE=0 6 * * *

# Database path (default works for Docker)
DB_PATH=/data/waste.db
